# Base de donnees (dev = SQLite, prod = PostgreSQL, voir README)
DATABASE_URL="file:./dev.db"

# Serveur
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Compte administrateur (créé au premier "npm run seed")
# Choisis de vrais identifiants — c'est le compte qui gère toute la boutique.
ADMIN_EMAIL="contact@taboutique.com"
ADMIN_PASSWORD="ChangeMoiEnUnMotDePasseSolide123!"
ADMIN_NOM="Diop"
ADMIN_PRENOM="Amadou"

# Réglages initiaux de la boutique (modifiables ensuite dans /admin/parametres)
BOUTIQUE_NOM="Ma Boutique"
BOUTIQUE_WHATSAPP="221771234567"

# Auth
JWT_SECRET="change-moi-en-production-avec-une-vraie-clef-longue-et-aleatoire"
JWT_EXPIRES_IN="7d"

# Wave Sénégal (sandbox/mock)
WAVE_API_KEY="wave_sandbox_xxx"
WAVE_SECRET="wave_secret_xxx"

# Orange Money Sénégal (sandbox/mock)
ORANGE_MONEY_MERCHANT_KEY="om_sandbox_xxx"
ORANGE_MONEY_SECRET="om_secret_xxx"

# Cloudinary (upload images produits/avis)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
